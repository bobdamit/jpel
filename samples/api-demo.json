{
  "id": "api-demo",
  "name": "Country Information API Demo",
  "description": "Demonstrates chained API activities using the free World Bank API (no key needed), with data processing",
  "start": "mainSequence",
  "variables": [
    {
      "name": "countryData",
      "type": "text",
      "description": "Country information from the World Bank API"
    },
    {
      "name": "countryReport",
      "type": "text",
      "description": "Formatted country report"
    }
  ],
  "activities": {
    "mainSequence": {
      "name": "Country Information Demo Sequence",
      "type": "sequence",
      "activities": [
        "getUserInput",
        "fetchCountryInfo",
        "fetchPopulation",
        "processResponse",
        "showResults"
      ]
    },
    "getUserInput": {
      "name": "Get Country Input",
      "type": "human",
      "prompt": "Let's explore country information using the World Bank API!",
      "fields": [
        {
          "name": "country",
          "type": "select",
          "label": "Country",
          "required": true,
          "description": "The country to get information about",
          "options": [
            { "label": "Australia", "value": "AU" },
            { "label": "Brazil", "value": "BR" },
            { "label": "Canada", "value": "CA" },
            { "label": "France", "value": "FR" },
            { "label": "Germany", "value": "DE" },
            { "label": "India", "value": "IN" },
            { "label": "Japan", "value": "JP" },
            { "label": "Kenya", "value": "KE" },
            { "label": "Mexico", "value": "MX" },
            { "label": "New Zealand", "value": "NZ" },
            { "label": "South Africa", "value": "ZA" },
            { "label": "United Kingdom", "value": "GB" },
            { "label": "United States", "value": "US" }
          ]
        },
        {
          "name": "infoType",
          "type": "select",
          "label": "Information Focus",
          "required": true,
          "options": [
            {
              "label": "General Overview",
              "value": "general"
            },
            {
              "label": "Location",
              "value": "location"
            }
          ],
          "defaultValue": "general"
        }
      ]
    },
    "fetchCountryInfo": {
      "name": "Fetch Country Information",
      "type": "api",
      "method": "GET",
      "url": "https://api.worldbank.org/v2/country/{{acts.getUserInput.country}}",
      "queryParams": {
        "format": "json"
      },
      "headers": {
        "Accept": "application/json",
        "User-Agent": "JPEL-Process-Engine/1.0"
      },
      "timeout": 15,
      "retries": 2,
      "expectedStatus": [
        200
      ],
      "code": [
        "// The World Bank API answers [paging, [country]] on success,",
        "// and [{ message: [...] }] (still HTTP 200) for a code it doesn't know",
        "const body = response.data;",
        "const country = Array.isArray(body) && Array.isArray(body[1]) ? body[1][0] : null;",
        "if (!country) {",
        "  const problem = body?.[0]?.message?.[0]?.value;",
        "  throw new Error(problem ? `World Bank API: ${problem}` : 'No country found for that code');",
        "}",
        "",
        "const result = {",
        "  name: country.name,",
        "  isoCode: country.iso2Code,",
        "  capital: country.capitalCity || 'N/A',",
        "  region: (country.region?.value || '').trim(),",
        "  incomeLevel: country.incomeLevel?.value || 'N/A',",
        "  latitude: Number(country.latitude),",
        "  longitude: Number(country.longitude)",
        "};",
        "",
        "// Store in a process variable for the next steps",
        "vars.countryData = JSON.stringify(result);",
        "return result;"
      ]
    },
    "fetchPopulation": {
      "name": "Fetch Population",
      "type": "api",
      "method": "GET",
      "url": "https://api.worldbank.org/v2/country/{{acts.getUserInput.country}}/indicator/SP.POP.TOTL",
      "queryParams": {
        "format": "json",
        "mrnev": "1"
      },
      "headers": {
        "Accept": "application/json",
        "User-Agent": "JPEL-Process-Engine/1.0"
      },
      "timeout": 15,
      "retries": 2,
      "expectedStatus": [
        200
      ],
      "code": [
        "// mrnev=1 asks for the most recent year that has a value",
        "const body = response.data;",
        "if (Array.isArray(body) && body[0]?.message?.[0]?.value) {",
        "  throw new Error('World Bank API: ' + body[0].message[0].value);",
        "}",
        "const latest = Array.isArray(body) && Array.isArray(body[1]) ? body[1][0] : null;",
        "// Add the population to what the previous step stored",
        "const countryData = JSON.parse(vars.countryData);",
        "countryData.population = latest?.value ?? null;",
        "countryData.populationYear = latest?.date ?? null;",
        "vars.countryData = JSON.stringify(countryData);",
        "",
        "return { population: countryData.population, populationYear: countryData.populationYear };"
      ]
    },
    "processResponse": {
      "name": "Generate Country Report",
      "type": "compute",
      "code": [
        "// Get the country data from the API calls",
        "const countryData = JSON.parse(vars.countryData);",
        "const infoType = acts.getUserInput.infoType;",
        "// Group thousands by hand: the sandbox's toLocaleString() doesn't",
        "const withCommas = n => String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');",
        "const population = countryData.population != null",
        "  ? `${withCommas(countryData.population)} people (${countryData.populationYear})`",
        "  : 'N/A';",
        "",
        "// Generate different reports based on user selection",
        "let report = [];",
        "",
        "if (infoType === 'general') {",
        "  report = [",
        "    `📍 COUNTRY OVERVIEW: ${countryData.name}`,",
        "    `Capital: ${countryData.capital}`,",
        "    `Population: ${population}`,",
        "    `Region: ${countryData.region}`,",
        "    `Income Level: ${countryData.incomeLevel}`,",
        "  ];",
        "} else if (infoType === 'location') {",
        "  const { latitude, longitude } = countryData;",
        "  report = [",
        "    `🌍 LOCATION: ${countryData.name}`,",
        "    `Region: ${countryData.region}`,",
        "    `Capital: ${countryData.capital} (${latitude.toFixed(2)}, ${longitude.toFixed(2)})`,",
        "    `Map: https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=6/${latitude}/${longitude}`,",
        "  ];",
        "}",
        "",
        "const reportText = report.join('\\n');",
        "",
        "// Store the formatted report",
        "vars.countryReport = reportText;",
        "",
        "return { reportType: infoType, reportText };"
      ]
    },
    "showResults": {
      "name": "Show Country Information",
      "type": "human",
      "prompt": "Here's the country information from the World Bank API. Please review and provide feedback:",
      "fields": [
        {
          "name": "feedback",
          "type": "text",
          "label": "Feedback",
          "required": false,
          "description": "Any comments about the country data or API integration"
        },
        {
          "name": "rating",
          "type": "select",
          "label": "Data Quality Rating",
          "required": true,
          "options": [
            {
              "label": "Excellent",
              "value": "excellent"
            },
            {
              "label": "Good",
              "value": "good"
            },
            {
              "label": "Average",
              "value": "average"
            },
            {
              "label": "Poor",
              "value": "poor"
            }
          ],
          "defaultValue": "good"
        },
        {
          "name": "requestMore",
          "type": "boolean",
          "label": "Research Another Country",
          "required": false,
          "description": "Would you like to look up information for another country?"
        }
      ]
    }
  }
}
