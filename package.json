{
	"name": "@rockscience/jpel",
	"version": "1.0.4",
	"description": "JPEL (JSON Process Execution Language): the specification, its JSON Schemas and sample processes",
	"keywords": [
		"jpel",
		"json-schema",
		"process",
		"workflow",
		"checklist",
		"quality-control"
	],
	"license": "MIT",
	"author": "Rock Science",
	"homepage": "https://github.com/bobdamit/jpel#readme",
	"bugs": "https://github.com/bobdamit/jpel/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bobdamit/jpel.git"
	},
	"type": "module",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./schema/*": "./schema/*",
		"./samples/*": "./samples/*",
		"./package.json": "./package.json"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"schema/*.json",
		"samples/"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "node scripts/build.mjs --check && node --test",
		"prepublishOnly": "npm test"
	},
	"devDependencies": {
		"ajv": "^8.20.0",
		"js-yaml": "^4.1.0"
	},
	"engines": {
		"node": ">=22"
	}
}
